# Required
AI_REWARDS_API_URL=https://appback.app/api/v1
AI_REWARDS_AGENT_JWT=            # Optional env override; start stores the issued JWT in SQLite
GC_API_URL=https://gc-v2-api.appback.app/api/v1
GC_WS_URL=https://gc-v2-api.appback.app

# Deprecated for one release: accepted only when the value is an AI Rewards JWT
GC_API_TOKEN=

# Agent identity is created by AI Rewards; never paste an old cr_agent_ credential
# AI_AGENT_NAME=appback-ai-agent

# Scheduler
GAME_DISCOVERY_INTERVAL_SEC=60
GC_QUEUE_POLL_INTERVAL_SEC=30
MAX_CONCURRENT_GAMES=1

# Model
MODEL_DIR=./models
DATA_DIR=./data

# Auto training
AUTO_TRAIN_AFTER_GAMES=50
AUTO_TRAIN_RETRY_MINUTES=60

# GC v8 authoritative training feed (used only when operation v8 is active)
GC_TRAINING_SYNC_ENABLED=true
GC_TRAINING_SYNC_INTERVAL_SEC=30
GC_V81_AUTO_TRAIN_ENABLED=true

# Python path (for venv: .venv/bin/python3)
# PYTHON_PATH=python3

# Logging
LOG_LEVEL=info
